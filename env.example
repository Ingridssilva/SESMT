# Copie este arquivo para ".env" e preencha com seus próprios valores.
# Nunca faça commit do arquivo ".env" real (ele já está no .gitignore).

# --- Banco de dados (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
# Alternativa (usada por scripts/importar_supabase.py), se preferir campos separados:
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Sessão Flask ---
FLASK_SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria

# --- Autenticação Azure AD (Entra ID) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
DOMINIO_EMAIL=suaempresa.com.br

# --- CORS ---
CORS_ORIGINS=http://localhost:5001

# --- SharePoint / Microsoft Graph API ---
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_PASTA_BASE=Departamento de SESMT

# --- ZapSign (assinatura digital) ---
ZAPSIGN_TOKEN=
ZAPSIGN_SANDBOX=true
ZAPSIGN_WEBHOOK_URL=

# --- Notificações por e-mail ---
SESMT_EMAIL_NOTIF=sesmt@suaempresa.com.br

# --- Proteção do endpoint de cron job ---
CRON_SECRET=troque-por-um-segredo-aleatorio
